# Copy to .env and fill in. Never commit .env.

# --- docker-compose (local Postgres) ---
POSTGRES_USER=cue
POSTGRES_PASSWORD=cue
POSTGRES_DB=cue
# 5434, not 5432, so it doesn't clash with a locally installed Postgres or other projects.
POSTGRES_PORT=5434

# --- packages/db ---
# Local: docker compose. Deployed: Supabase's Session pooler (docs/deploy.md), e.g.
# postgresql://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://cue:cue@localhost:5434/cue
# Optional: most connections per process (default 10). Deployed: web 1, realtime 5,
# because the Session pooler holds one Postgres connection per client connection.
# DATABASE_POOL_MAX=
# Admin URL for integration tests: they create and drop throwaway cue_test_* databases here.
TEST_DATABASE_URL=postgres://cue:cue@localhost:5434/postgres

# --- packages/ingest (pnpm ingest) ---
# Optional. Only needed for gated or private Hugging Face datasets: create a
# read token at https://huggingface.co/settings/tokens. Never commit it.
HF_TOKEN=
# Optional. Where imported audio is stored (default: ./data/blobs, gitignored).
# Also read by apps/web, which streams it on the replay page.
# BLOB_STORE_DIR=

# --- apps/realtime ---
REALTIME_HOST=localhost
# Hosts like Render set PORT instead; REALTIME_PORT wins if both are set.
REALTIME_PORT=4000
LOG_LEVEL=info
# Shared by apps/web (signs WebSocket tickets) and apps/realtime (verifies them).
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
REALTIME_TICKET_SECRET=
# Browser origins allowed to open the realtime WebSocket (comma-separated).
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# Suggestions (optional). Without a key, replays run without suggestions.
# Get a key at https://console.groq.com/keys. Never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Drop a suggestion if its first token takes longer than this (late is worse than none).
# SUGGESTION_FIRST_TOKEN_TIMEOUT_MS=1500
# SUGGESTION_TOTAL_TIMEOUT_MS=5000

# --- packages/evals (pnpm eval) ---
# Uses GROQ_API_KEY and GROQ_MODEL above. The judge must be a different model.
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# --- apps/web ---
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000
# Signs/encrypts session cookies; at least 32 chars. Generate: npx auth secret
AUTH_SECRET=
# GitHub OAuth app (github.com/settings/developers -> New OAuth App).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Production only: the app's public URL, e.g. https://cue.example.com (Vercel detects it).
# AUTH_URL=
# Optional, comma-separated GitHub logins. If set, only they may use the app;
# everyone else sees an "invite-only" page. Unset = anyone who signs in.
# ALLOWED_GITHUB_LOGINS=
# "off" in deployments: no recording audio is hosted (the audio route always 404s).
# AUDIO_PLAYBACK=on
