# Copy to .env and fill in. Never commit .env.

# --- docker-compose (local Postgres) ---
POSTGRES_USER=cue
POSTGRES_PASSWORD=cue
POSTGRES_DB=cue
POSTGRES_PORT=5432

# --- packages/db ---
DATABASE_URL=postgres://cue:cue@localhost:5432/cue

# --- apps/realtime ---
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4000
LOG_LEVEL=info

# --- apps/web ---
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000
